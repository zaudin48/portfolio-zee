# Copy this file to ".env" and fill in the values from your Firebase project
# (Firebase console → Project settings → General → Your apps → SDK setup and configuration).
# .env is only needed if you want to run the site on your own computer with
# `npm run dev`. For the live GitHub Pages site, these same values go into
# GitHub repo secrets instead — see README.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only needed for the "Or upload a photo" buttons in the admin
# panel. Free, no card required: sign up at https://api.imgbb.com,
# grab your API key from that page, paste it here (and as a GitHub
# secret named VITE_IMGBB_KEY for the live site). Without this, the
# upload button just shows a friendly error — pasting a URL still works.
VITE_IMGBB_KEY=
