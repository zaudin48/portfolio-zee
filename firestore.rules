rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read your projects/games and site settings (it's a
    // public portfolio). Only a signed-in admin (you) can add, edit,
    // or delete anything.
    match /work/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Visitor analytics: any visitor's browser can write its OWN
    // tracking doc (that's how the tracking script works — no login
    // needed to record a visit), but nobody except you can READ the
    // analytics data, and nobody but you can delete old records.
    match /visitors/{sessionId} {
      allow create: if request.resource.data.sessionId == sessionId;
      allow update: if resource.data.sessionId == sessionId;
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}