rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read your projects/games and site settings (it's a
    // public portfolio). Only a signed-in admin (you) can add, edit,
    // or delete anything.
    match /work/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
